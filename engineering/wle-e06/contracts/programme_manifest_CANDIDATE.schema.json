{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workledger:wle-e06:programme-manifest:candidate:v0.1",
  "$comment": "DESIGN CANDIDATE ONLY. Cross-field/semantic graph, E05 scope, JCS digest, signer and professional review verified separately; not current QS published schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_system",
    "source_instance",
    "external_project_id",
    "external_programme_id",
    "source_revision",
    "programme_status",
    "generation_stage",
    "request_id",
    "organization_id",
    "project_id",
    "contract_id",
    "boq_version_id",
    "boq_snapshot_sha256",
    "calendar",
    "tasks",
    "dependencies",
    "provenance",
    "review",
    "published_at",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0-rc1"
    },
    "source_system": {
      "const": "qs-service"
    },
    "source_instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "external_project_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "external_programme_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "programme_status": {
      "const": "confirmed"
    },
    "generation_stage": {
      "const": "complete"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "boq_version_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "boq_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "working_days",
        "hours_per_day",
        "calendar_revision"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 3
        },
        "working_days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "hours_per_day": {
          "type": "string",
          "pattern": "^\\d{1,2}(?:\\.\\d{1,2})?$"
        },
        "calendar_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_task_id",
          "wbs_code",
          "title",
          "start_date",
          "finish_date",
          "duration_days",
          "is_milestone",
          "total_float_days"
        ],
        "properties": {
          "external_task_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "wbs_code": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "finish_date": {
            "type": "string",
            "format": "date"
          },
          "duration_days": {
            "type": "string",
            "pattern": "^\\d{1,6}(?:\\.\\d{1,3})?$"
          },
          "is_milestone": {
            "type": "boolean"
          },
          "total_float_days": {
            "type": "string",
            "pattern": "^\\d{1,6}(?:\\.\\d{1,3})?$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 12000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_external_task_id",
          "to_external_task_id",
          "link_type",
          "lag_days"
        ],
        "properties": {
          "from_external_task_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "to_external_task_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "link_type": {
            "enum": [
              "FS",
              "SS",
              "FF",
              "SF"
            ]
          },
          "lag_days": {
            "type": "string",
            "pattern": "^(?:0|-?[1-9]\\d{0,4})(?:\\.\\d{1,2})?$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "skills",
        "stage_decision_ids",
        "source_record_sha256"
      ],
      "properties": {
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "version"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stage_decision_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "approved_at",
        "reviewer_identity",
        "reviewer_role",
        "decision_reason"
      ],
      "properties": {
        "decision_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "decision_reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
